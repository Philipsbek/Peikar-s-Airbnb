---
import '../styles/global.css';
import AmbientIllustrations from '../components/AmbientIllustrations.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Eztidor Solution — spacious, spotless short- and long-term homestays in Kuantan, Pahang, Malaysia. A verified Airbnb Superhost with a 4.82 rating across 192 reviews on Airbnb.',
  keywords = 'homestay Kuantan, Kuantan homestay, homestay Pahang, Kuantan accommodation, short term homestay Kuantan, long term homestay Kuantan, villa Kuantan, Eztidor Solution',
  image = '/images/logo.png',
  type = 'website',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://eztidorsolution.com');
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;

// Content Security Policy — applied in production only (the dev server needs
// inline scripts / HMR). Allows our own assets, Google Fonts and the Google
// Maps embed used on property pages; blocks everything else.
const csp = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "img-src 'self' data:",
  "font-src 'self' https://fonts.gstatic.com",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "script-src 'self'",
  "connect-src 'self'",
  "frame-src https://www.google.com https://maps.google.com",
  "form-action 'self'",
  "upgrade-insecure-requests",
].join('; ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Eztidor Solution" />
    <meta name="geo.region" content="MY-06" />
    <meta name="geo.placename" content="Kuantan, Pahang, Malaysia" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Eztidor Solution" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_MY" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=DM+Sans:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div id="page-loader" class="page-loader" role="status" aria-label="Loading">
      <div class="pl-inner">
        <img src="/images/logo.png" alt="Eztidor Solution" class="pl-logo" width="220" height="73" fetchpriority="low" decoding="async" />
        <span class="pl-bar" aria-hidden="true"></span>
      </div>
    </div>

    <AmbientIllustrations />
    <div class="site-content">
      <slot />
    </div>
    <script>
      import '../scripts/i18n';
      import '../scripts/page-loader';
    </script>
  </body>
</html>

<style is:global>
  .site-content { position: relative; z-index: 1; }

  /* Page-change loader — warm cream canvas, logo + sage-green progress bar */
  .page-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    background: var(--color-warm-canvas);
    transition: opacity 0.5s ease, visibility 0.5s ease;
  }
  .page-loader.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .pl-inner { display: flex; flex-direction: column; align-items: center; gap: 22px; }
  .pl-logo { height: 62px; width: auto; animation: pl-pulse 1.5s ease-in-out infinite; }
  .pl-bar {
    position: relative;
    width: 170px;
    height: 3px;
    border-radius: 999px;
    background: rgba(42, 35, 24, 0.12);
    overflow: hidden;
  }
  .pl-bar::after {
    content: '';
    position: absolute;
    top: 0;
    left: -40%;
    height: 100%;
    width: 40%;
    border-radius: 999px;
    background: var(--color-coral-pulse);
    animation: pl-slide 1.1s ease-in-out infinite;
  }
  @keyframes pl-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.72; transform: scale(0.97); }
  }
  @keyframes pl-slide {
    0% { left: -40%; }
    60% { left: 70%; }
    100% { left: 110%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pl-logo { animation: none; }
    .pl-bar::after { animation: none; left: 0; width: 100%; }
  }
</style>
