---
import '../styles/global.css';
import AmbientIllustrations from '../components/AmbientIllustrations.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Eztidor Solution — spacious, spotless short- and long-term homestays in Kuantan, Malaysia. A verified Superhost with a 4.82 rating across 192 reviews.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=DM+Sans:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <AmbientIllustrations />
    <div class="site-content">
      <slot />
    </div>
    <script>
      import '../scripts/i18n';
    </script>
  </body>
</html>

<style is:global>
  .site-content { position: relative; z-index: 1; }
</style>
