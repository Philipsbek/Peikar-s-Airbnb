---
import Base from '../../layouts/Base.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import PhotoLightbox from '../../components/PhotoLightbox.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import host from '../../data/host.json';

export function getStaticPaths() {
  return host.listings.map((listing) => ({ params: { id: listing.id }, props: { listing } }));
}

const { listing } = Astro.props;
const images: string[] = listing.images?.length ? listing.images : [listing.image];
const address = listing.address ?? 'Kuantan, Pahang, Malaysia';
const mapQuery =
  (listing as any).lat != null && (listing as any).lng != null
    ? `${(listing as any).lat},${(listing as any).lng}`
    : address;
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(mapQuery)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;

const facts = [
  { key: 'guests', label: 'guests', value: listing.guests },
  { key: 'bedrooms', label: 'bedrooms', value: listing.bedrooms },
  { key: 'baths', label: 'baths', value: listing.bathrooms },
].filter((f) => f.value);

const icons: Record<string, string> = {
  guests:
    '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0"/><path d="M16 5.2a3 3 0 0 1 0 5.6M17.5 20a5.5 5.5 0 0 0-3-4.9"/></svg>',
  bedrooms:
    '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6M3 14h18M3 18v2M21 18v2M7 10V8a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"/></svg>',
  baths:
    '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z"/><path d="M5 12V6a2 2 0 0 1 2-2 2 2 0 0 1 2 2M7 19l-1 2M18 19l1 2"/></svg>',
};

const lead = images[0];
const thumbs = images.slice(1, 5);
const waMessage = `Hi Eztidor Solution! I'm interested in booking ${listing.shortName} in Kuantan. Could you please share the availability and booking details?`;
const waHref = `https://wa.me/${host.whatsapp.number}?text=${encodeURIComponent(waMessage)}`;
---

<Base title={`${listing.shortName} · Eztidor Solution`}>
  <WhatsAppButton />
  <PhotoLightbox />

  <header class="pd-top">
    <div class="container pd-top-inner">
      <a href="/" class="pd-brand"><img src="/images/logo.png" alt="Eztidor Solution — Homestay Services" /></a>
      <div class="pd-top-actions">
        <LanguageSwitcher />
        <a href="/#stays" class="pd-back">All stays</a>
      </div>
    </div>
  </header>

  <main class="container pd" data-images={JSON.stringify(images)} data-pd-title={listing.shortName}>
    <a href="/#stays" class="pd-crumb">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      Back to all stays
    </a>

    <h1 class="pd-title">{listing.shortName}</h1>
    <p class="pd-meta">
      <span class="pd-star">★ {listing.rating.toFixed(2)}</span>
      <span>· {listing.reviewCount} reviews ·</span>
      <span class="pd-meta-addr">{address}</span>
    </p>

    <!-- Gallery -->
    <section class="pd-gallery">
      <img class="pd-lead" src={lead} alt={`${listing.shortName} — main photo`} width="960" height="640" />
      {thumbs.length > 0 && (
        <div class="pd-thumbs">
          {thumbs.map((image, index) => (
            <img src={image} alt={`${listing.shortName} — photo ${index + 2}`} loading="lazy" width="480" height="360" />
          ))}
        </div>
      )}
    </section>

    {images.length > 5 && (
      <button class="pd-showall" type="button" data-showall>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg>
        Show all {images.length} photos
      </button>
    )}

    {images.length > 5 && (
      <dialog class="pd-lightbox" data-lightbox aria-label={`All photos of ${listing.shortName}`}>
        <div class="pd-lb-shell">
          <header class="pd-lb-bar">
            <span class="pd-lb-title">{listing.shortName} · {images.length} photos</span>
            <button class="pd-lb-close" type="button" data-lb-close aria-label="Close photos">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
            </button>
          </header>
          <div class="pd-lb-scroll">
            <div class="pd-lb-grid">
              {images.map((image, index) => (
                <img src={image} alt={`${listing.shortName} — photo ${index + 1}`} loading="lazy" />
              ))}
            </div>
          </div>
        </div>
      </dialog>
    )}

    <!-- Body -->
    <div class="pd-body">
      <div class="pd-main">
        <section class="pd-section">
          <h2 class="pd-h2">{listing.roomType} by Eztidor Solution</h2>
          <div class="pd-facts">
            {facts.map((f) => (
              <div class="pd-fact">
                <span class="pd-fact-icon" set:html={icons[f.key]} />
                <span><strong>{f.value}</strong> {f.label}</span>
              </div>
            ))}
          </div>
        </section>

        <section class="pd-section">
          <h2 class="pd-h2">Where you'll be</h2>
          <p class="pd-address">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
            {address}
          </p>
          <div class="pd-map">
            <iframe title={`Map of ${listing.shortName}`} src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </section>
      </div>

      <aside class="pd-aside">
        <div class="pd-book-card">
          <p class="pd-book-rating">★ {listing.rating.toFixed(2)} · {listing.reviewCount} reviews</p>
          <p class="pd-book-note">Message Eztidor Solution directly to check availability and book this stay.</p>
          <a class="pd-book-btn" href={waHref} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16.003 3C9.38 3 3.998 8.38 3.998 15c0 2.096.55 4.142 1.594 5.945L3 29l8.28-2.54A12.9 12.9 0 0 0 16 27c6.623 0 12.005-5.38 12.005-12S22.626 3 16.003 3zm0 21.8c-1.86 0-3.68-.5-5.27-1.44l-.38-.22-4.9 1.5 1.5-4.78-.25-.4A9.78 9.78 0 0 1 6.2 15c0-5.4 4.4-9.8 9.8-9.8 5.4 0 9.8 4.4 9.8 9.8 0 5.4-4.4 9.8-9.8 9.8z"/></svg>
            Ask about this stay
          </a>
        </div>
      </aside>
    </div>
  </main>
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-showall]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');

  btn?.addEventListener('click', () => {
    if (!dialog) return;
    document.documentElement.style.overflow = 'hidden';
    dialog.showModal();
    dialog.querySelector('.pd-lb-scroll')?.scrollTo({ top: 0 });
  });
  dialog?.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  dialog?.addEventListener('close', () => { document.documentElement.style.overflow = ''; });

  // Click any photo → single-image zoom lightbox
  const main = document.querySelector<HTMLElement>('.pd');
  const allImages: string[] = JSON.parse(main?.dataset.images || '[]');
  const pageTitle = main?.dataset.pdTitle || 'Property photos';
  const zoom = (start: number) => (window as any).openPhotoLightbox?.(allImages, pageTitle, start);

  document.querySelector('.pd-lead')?.addEventListener('click', () => zoom(0));
  document.querySelectorAll<HTMLElement>('.pd-thumbs img').forEach((img, i) => img.addEventListener('click', () => zoom(i + 1)));
  document.querySelectorAll<HTMLElement>('.pd-lb-grid img').forEach((img, i) => img.addEventListener('click', () => zoom(i)));
</script>

<style>
  .pd-top { position: sticky; top: 0; z-index: 40; background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(16px) saturate(140%); -webkit-backdrop-filter: blur(16px) saturate(140%); border-bottom: var(--hairline); }
  .pd-top-inner { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .pd-brand { display: inline-flex; align-items: center; }
  .pd-brand img { height: 40px; width: auto; display: block; }
  .pd-top-actions { display: flex; align-items: center; gap: var(--spacing-12); }
  @media (max-width: 560px) { .pd-brand img { height: 34px; } }
  .pd-back { font-size: var(--text-body); }
  .pd-back:hover { color: var(--color-coral-pulse); }

  .pd { padding-block: var(--spacing-32) var(--spacing-96); }
  .pd-crumb { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-caption); font-weight: 700; color: #4a4a44; }
  .pd-crumb svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .pd-crumb:hover { color: var(--color-coral-pulse); }
  .pd-title { margin-top: var(--spacing-16); font-size: clamp(28px, 4vw, 42px); font-weight: 700; line-height: 1.1; }
  .pd-meta { margin-top: var(--spacing-8); display: flex; flex-wrap: wrap; gap: 6px; font-size: var(--text-body); color: #4a4a44; }
  .pd-star { font-weight: 700; color: var(--color-coral-pulse); }
  .pd-meta-addr { color: #4a4a44; }

  /* Gallery */
  .pd-gallery { margin-top: var(--spacing-24); display: grid; grid-template-columns: 2fr 1fr; gap: 10px; }
  .pd-lead { width: 100%; height: 100%; max-height: 520px; object-fit: cover; border-radius: var(--radius-cards); cursor: pointer; transition: filter 0.18s ease; }
  .pd-lead:hover { filter: brightness(0.94); }
  .pd-thumbs { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .pd-thumbs img { width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius-cards); aspect-ratio: 4/3; cursor: pointer; transition: filter 0.18s ease; }
  .pd-thumbs img:hover { filter: brightness(0.94); }
  @media (max-width: 720px) {
    .pd-gallery { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto; }
    .pd-lead { display: block; height: auto; max-height: 320px; aspect-ratio: 3 / 2; }
    .pd-thumbs { grid-template-columns: 1fr 1fr; }
    .pd-thumbs img { display: block; height: auto; }
  }

  .pd-showall { margin-top: var(--spacing-16); display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border: 1px solid var(--color-ink-black); border-radius: var(--radius-full); background: var(--color-pristine-surface); font: inherit; font-size: var(--text-caption); font-weight: 700; cursor: pointer; transition: background 0.18s ease, color 0.18s ease; }
  .pd-showall:hover { background: var(--color-ink-black); color: #fff; }
  .pd-showall svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; }

  /* Full-screen photo lightbox */
  .pd-lightbox { width: 100vw; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; }
  .pd-lightbox::backdrop { background: rgba(0, 0, 0, 0.5); }
  .pd-lb-shell { display: flex; flex-direction: column; height: 100dvh; background: var(--color-warm-canvas); }
  .pd-lb-bar { position: sticky; top: 0; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 24px; background: var(--color-warm-canvas); border-bottom: var(--hairline); }
  .pd-lb-title { font-size: var(--text-subheading); font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pd-lb-close { display: grid; place-items: center; width: 44px; height: 44px; flex: 0 0 auto; border: var(--hairline); border-radius: 999px; background: var(--color-pristine-surface); cursor: pointer; transition: background 0.18s ease, color 0.18s ease; }
  .pd-lb-close:hover { background: var(--color-ink-black); color: #fff; }
  .pd-lb-close svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .pd-lb-scroll { flex: 1; overflow-y: auto; }
  .pd-lb-grid { max-width: 1040px; margin: 0 auto; padding: 24px; columns: 3; column-gap: 12px; }
  .pd-lb-grid img { display: block; width: 100%; margin-bottom: 12px; border-radius: var(--radius-cards); break-inside: avoid; cursor: pointer; transition: filter 0.18s ease; }
  .pd-lb-grid img:hover { filter: brightness(0.92); }
  @media (max-width: 900px) { .pd-lb-grid { columns: 2; } }
  @media (max-width: 560px) { .pd-lb-grid { columns: 1; padding: 16px; } }

  /* Body */
  .pd-body { margin-top: var(--spacing-40); display: grid; grid-template-columns: 1fr 340px; gap: var(--spacing-40); align-items: start; }
  .pd-section { padding-block: var(--spacing-24); border-top: var(--hairline); }
  .pd-section:first-child { border-top: 0; padding-top: 0; }
  .pd-h2 { font-size: var(--text-heading); font-weight: 700; }
  .pd-facts { display: flex; flex-wrap: wrap; gap: 12px; margin-top: var(--spacing-16); }
  .pd-fact { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border: var(--hairline); border-radius: 12px; font-size: var(--text-caption); }
  .pd-fact strong { font-weight: 700; }
  .pd-fact-icon { display: inline-flex; }
  .pd-fact-icon :global(svg) { width: 20px; height: 20px; fill: none; stroke: var(--color-coral-pulse); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .pd-address { display: flex; align-items: center; gap: 8px; margin-top: var(--spacing-12); font-size: var(--text-body); color: #4a4a44; }
  .pd-address svg { width: 18px; height: 18px; flex: 0 0 auto; fill: none; stroke: var(--color-coral-pulse); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .pd-map { margin-top: var(--spacing-16); border-radius: var(--radius-cards); overflow: hidden; border: var(--hairline); }
  .pd-map iframe { display: block; width: 100%; height: 360px; border: 0; }

  .pd-aside { position: sticky; top: 84px; }
  .pd-book-card { background: var(--color-pristine-surface); border: var(--hairline); border-radius: var(--radius-cards); padding: var(--card-padding); }
  .pd-book-rating { font-weight: 700; }
  .pd-book-note { margin-top: var(--spacing-8); font-size: var(--text-caption); color: #4a4a44; }
  .pd-book-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; width: 100%; min-height: 48px; margin-top: var(--spacing-16); border-radius: var(--radius-full); background: var(--color-coral-pulse); color: #fff; font-size: var(--text-body); font-weight: 700; transition: background 0.18s ease, transform 0.18s ease; }
  .pd-book-btn:hover { background: var(--color-ink-black); transform: translateY(-2px); }
  .pd-book-btn svg { width: 20px; height: 20px; flex: 0 0 auto; }

  @media (max-width: 860px) {
    .pd-body { grid-template-columns: 1fr; gap: var(--spacing-24); }
    .pd-aside { position: static; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pd-showall, .pd-book-btn { transition: none; }
    .pd-book-btn:hover { transform: none; }
  }
</style>
