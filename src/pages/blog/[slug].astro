---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import blog from '../../data/blog.json';
import host from '../../data/host.json';

export function getStaticPaths() {
  return blog.posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const site = Astro.site ?? new URL('https://eztidor.com');
const url = new URL(`/blog/${post.slug}`, site).href;
const coverAbs = new URL(post.cover, site).href;

const related = blog.posts.filter((p) => p.slug !== post.slug).slice(0, 3);
const waHref = `https://wa.me/${host.whatsapp.number}?text=${encodeURIComponent(host.whatsapp.message)}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.metaDescription,
  image: coverAbs,
  datePublished: post.date,
  dateModified: post.date,
  inLanguage: 'en-MY',
  articleSection: post.category,
  keywords: post.keywords.join(', '),
  author: { '@type': 'Organization', name: 'Eztidor Solution' },
  publisher: {
    '@type': 'Organization',
    name: 'Eztidor Solution',
    logo: { '@type': 'ImageObject', url: new URL('/images/logo.png', site).href },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  about: { '@type': 'Place', name: 'Kuantan, Pahang, Malaysia' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', site).href },
    { '@type': 'ListItem', position: 3, name: post.title, item: url },
  ],
};
---

<Base
  title={post.metaTitle}
  description={post.metaDescription}
  keywords={post.keywords.join(', ')}
  image={post.cover}
  type="article"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />

  <span id="top"></span>
  <Nav />
  <WhatsAppButton />

  <main class="article-page">
    <div class="container crumbs-wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/blog">Blog</a><span>/</span><span class="crumb-current"><span data-lang="en">{post.category}</span><span data-lang="ms">{post.i18n.ms.category}</span><span data-lang="zh">{post.i18n.zh.category}</span></span>
      </nav>
    </div>

    <header class="article-hero" style={`background-image: url('${post.cover}')`}>
      <div class="article-hero-inner container">
        <span class="article-cat"><span data-lang="en">{post.category}</span><span data-lang="ms">{post.i18n.ms.category}</span><span data-lang="zh">{post.i18n.zh.category}</span></span>
        <h1 class="article-title"><span data-lang="en">{post.title}</span><span data-lang="ms">{post.i18n.ms.title}</span><span data-lang="zh">{post.i18n.zh.title}</span></h1>
        <p class="article-meta">By {post.author} · {post.dateDisplay} · <span data-lang="en">{post.readTime}</span><span data-lang="ms">{post.i18n.ms.readTime}</span><span data-lang="zh">{post.i18n.zh.readTime}</span></p>
      </div>
      {post.coverCredit && <span class="article-hero-credit">{post.coverCredit}</span>}
    </header>

    <article class="article container">
      <div class="article-body" data-lang="en" set:html={post.body} />
      <div class="article-body" data-lang="ms" set:html={post.i18n.ms.body || post.body} />
      <div class="article-body" data-lang="zh" set:html={post.i18n.zh.body || post.body} />

      <div class="article-tags">
        {post.keywords.map((k) => <span class="tag">{k}</span>)}
      </div>

      <aside class="article-cta">
        <h2>Looking for a homestay in Kuantan?</h2>
        <p>Eztidor Solution offers spacious, fully-furnished short- and long-term homestays across Kuantan, Pahang.</p>
        <div class="article-cta-actions">
          <a href="/#stays" class="btn btn--coral">Browse our stays</a>
          <a href={waHref} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">Chat with us</a>
        </div>
      </aside>
    </article>

    <section class="related">
      <h2 class="related-title">Keep reading</h2>
      <div class="related-grid">
        {related.map((p) => (
          <a class="related-card" href={`/blog/${p.slug}`}>
            <img src={p.cover} alt={p.title} width="1200" height="675" loading="lazy" />
            <div class="related-body">
              <span class="related-cat"><span data-lang="en">{p.category}</span><span data-lang="ms">{p.i18n.ms.category}</span><span data-lang="zh">{p.i18n.zh.category}</span></span>
              <h3 class="related-h3"><span data-lang="en">{p.title}</span><span data-lang="ms">{p.i18n.ms.title}</span><span data-lang="zh">{p.i18n.zh.title}</span></h3>
            </div>
          </a>
        ))}
      </div>
      <a class="related-all" href="/blog">← All articles</a>
    </section>
  </main>

  <footer class="blog-footer">
    <div class="container blog-footer-inner">
      <p class="blog-footer-brand">Eztidor<span>·</span>Solution</p>
      <p class="blog-footer-fine">Homestays in Kuantan, Pahang, Malaysia · <a href="/">Back to home</a></p>
    </div>
  </footer>
</Base>

<style>
  .article-page { padding-bottom: var(--spacing-96); }
  .crumbs-wrap { padding-top: var(--spacing-24); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: var(--text-caption); color: #6b6258; }
  .crumbs a:hover { color: var(--color-coral-pulse); }
  .crumbs span { opacity: 0.6; }
  .crumb-current { color: var(--color-ink-black); opacity: 1; font-weight: 700; }

  /* Full-bleed hero — image spans the viewport, title overlaid so nothing is cropped */
  .article-hero { position: relative; margin-top: var(--spacing-16); min-height: clamp(360px, 56vh, 560px); background-size: cover; background-position: center; display: flex; align-items: flex-end; }
  .article-hero::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.12) 0%, rgba(0,0,0,0.3) 45%, rgba(0,0,0,0.72) 100%); }
  .article-hero-inner { position: relative; z-index: 1; padding-block: var(--spacing-40); color: #fff; }
  .article-cat { display: inline-block; background: var(--color-coral-pulse); color: #fff; font-size: var(--text-caption); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 6px 14px; border-radius: var(--radius-full); }
  .article-title { margin-top: var(--spacing-16); font-size: clamp(30px, 4.6vw, 52px); font-weight: 600; line-height: 1.12; color: #fff; max-width: 22ch; text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35); }
  .article-meta { margin-top: var(--spacing-12); font-size: var(--text-caption); color: rgba(255, 255, 255, 0.92); }
  .article-hero-credit { position: absolute; right: 10px; bottom: 8px; z-index: 1; font-size: 11px; color: rgba(255, 255, 255, 0.7); background: rgba(0, 0, 0, 0.3); padding: 3px 8px; border-radius: 6px; max-width: 70%; text-align: right; }

  .article { max-width: 820px; padding-top: var(--spacing-40); }

  .article-body { margin-top: var(--spacing-32); font-size: var(--text-body); line-height: 1.7; color: #2d2a24; }
  .article-body :global(h2) { font-family: var(--font-display); font-size: var(--text-heading); font-weight: 600; line-height: 1.2; margin-top: var(--spacing-32); }
  .article-body :global(h3) { font-family: var(--font-display); font-size: var(--text-subheading); font-weight: 600; margin-top: var(--spacing-24); }
  .article-body :global(p) { margin-top: var(--spacing-16); }
  .article-body :global(ul) { margin-top: var(--spacing-16); padding-left: 0; list-style: none; display: grid; gap: var(--spacing-8); }
  .article-body :global(li) { position: relative; padding-left: 28px; }
  .article-body :global(li)::before { content: '✓'; position: absolute; left: 0; top: 0; width: 18px; height: 18px; border-radius: var(--radius-full); background: rgba(111, 147, 80, 0.16); color: var(--color-coral-pulse); font-size: 11px; font-weight: 700; display: grid; place-items: center; }
  .article-body :global(strong) { font-weight: 700; color: var(--color-ink-black); }
  .article-body :global(a) { color: var(--color-coral-pulse); text-decoration: underline; text-underline-offset: 2px; font-weight: 600; }

  .article-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: var(--spacing-32); padding-top: var(--spacing-24); border-top: var(--hairline); }
  .tag { font-size: var(--text-caption); color: #6b6258; background: var(--color-sand-beige); border-radius: var(--radius-full); padding: 5px 12px; }

  .article-cta { margin-top: var(--spacing-32); background: var(--color-sand-beige); border: var(--hairline); border-radius: var(--radius-cards); padding: var(--spacing-32); }
  .article-cta h2 { font-family: var(--font-display); font-size: var(--text-heading); font-weight: 600; }
  .article-cta p { margin-top: var(--spacing-8); color: #4a4a44; }
  .article-cta-actions { display: flex; flex-wrap: wrap; gap: var(--spacing-12); margin-top: var(--spacing-20); }

  .related { max-width: 1040px; margin: var(--spacing-64) auto 0; padding-inline: var(--spacing-16); }
  .related-title { font-family: var(--font-display); font-size: var(--text-heading); font-weight: 600; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-24); margin-top: var(--spacing-24); }
  .related-card { display: flex; flex-direction: column; background: var(--color-pristine-surface); border: var(--hairline); border-radius: var(--radius-cards); overflow: hidden; transition: transform 0.2s ease; }
  .related-card:hover { transform: translateY(-4px); }
  .related-card img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .related-body { padding: var(--spacing-16); }
  .related-cat { font-size: var(--text-caption); font-weight: 700; color: var(--color-coral-pulse); }
  .related-h3 { margin-top: 6px; font-size: var(--text-body); font-weight: 600; line-height: 1.3; }
  .related-all { display: inline-block; margin-top: var(--spacing-24); font-weight: 700; color: var(--color-coral-pulse); }

  @media (max-width: 760px) { .related-grid { grid-template-columns: 1fr; } }

  .blog-footer { background: var(--color-ink-black); color: #fff; padding-block: var(--spacing-40); margin-top: var(--spacing-64); }
  .blog-footer-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-16); flex-wrap: wrap; }
  .blog-footer-brand { font-family: var(--font-display); font-size: var(--text-heading); font-weight: 600; }
  .blog-footer-brand span { color: var(--color-clay); margin-inline: 2px; }
  .blog-footer-fine { font-size: var(--text-caption); opacity: 0.7; }
  .blog-footer-fine a { text-decoration: underline; }
</style>
