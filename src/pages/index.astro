---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import ListingCard from '../components/ListingCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ShowcaseSection from '../components/ShowcaseSection.astro';
import host from '../data/host.json';

// De-duplicate listings that are the same property relisted (same short name).
const seen = new Set<string>();
const listings = host.listings.filter((l) => {
  if (seen.has(l.shortName + l.image)) return false;
  seen.add(l.shortName + l.image);
  return true;
});

const heroImage = host.listings[0].image;

const facts = [
  { icon: 'briefcase', label: 'My work', value: host.work },
  { icon: 'globe', label: 'Lives in', value: host.location },
  { icon: 'language', label: 'Speaks', value: host.languages },
  { icon: 'cake', label: 'Born in the', value: host.bornIn },
];
---

<Base title="Peikar · Superhost stays in Kuantan, Malaysia">
  <span id="top"></span>
  <Nav />
  <WhatsAppButton />

  <!-- ============================ HERO ============================ -->
  <section class="hero container">
    <div class="hero-photo" style={`background-image: url('${heroImage}')`}>
      <div class="hero-photo-overlay">
        <span class="badge hero-badge">
          <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path fill="#fff" d="M8 1.5l2 4.7 5.1.4-3.9 3.4 1.2 5L8 12.2 3.6 15l1.2-5L.9 6.6l5.1-.4z"/></svg>
          Airbnb Superhost
        </span>
        <h1 class="hero-title">Spacious homes for the whole crew in Kuantan</h1>
        <p class="hero-sub">
          {host.stats.totalListings} vacation houses hosted by Peikar — beachside villas, pool
          bungalows and family retreats, each kept spotless and ready for groups of up to 30.
        </p>
      </div>
    </div>

    <aside class="hero-card" id="hero-card">
      <div class="hc-bg" aria-hidden="true">
        <span class="hc-blob hc-blob--1"></span>
        <span class="hc-blob hc-blob--2"></span>
        <span class="hc-blob hc-blob--3"></span>
        <span class="hc-blob hc-blob--4"></span>
        <svg class="hc-doodle" viewBox="0 0 400 560" fill="none" preserveAspectRatio="xMidYMid slice">
          <!-- sun, top-right -->
          <g class="hc-d hc-d--1" stroke="#e8846e" stroke-width="2.4" stroke-linecap="round">
            <circle cx="330" cy="70" r="18" />
            <path d="M330 34v-14M330 120v-14M366 70h14M280 70h14M356 44l10-10M294 106l10-10M356 96l10 10M294 34l10 10" />
          </g>
          <!-- little house, bottom-left -->
          <g class="hc-d hc-d--2" stroke="#5ba894" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M40 500l34-28 34 28M48 494v34h52v-34M66 528v-20h16v20" />
          </g>
          <!-- squiggle, mid -->
          <path class="hc-d hc-d--3" d="M40 250c14-16 30-16 44 0s30 16 44 0 30-16 44 0" stroke="#c9a0d6" stroke-width="2.4" stroke-linecap="round" />
          <!-- sparkles -->
          <g class="hc-d hc-d--4" stroke="#e8b45e" stroke-width="2.2" stroke-linecap="round">
            <path d="M120 110v16M112 118h16" />
            <path d="M300 470v12M294 476h12" />
          </g>
        </svg>
      </div>

      <span class="badge">Meet your host</span>
      <div class="hero-card-host">
        <img src={host.profilePhoto} alt="Peikar, Superhost" width="72" height="72" />
        <div>
          <p class="hero-card-name">{host.name}</p>
          <p class="hero-card-role">Superhost · {host.stats.yearsHosting} years hosting</p>
        </div>
      </div>
      <div class="hero-card-stats">
        <div>
          <span class="stat-value">{host.stats.rating}</span>
          <span class="stat-label">Rating</span>
        </div>
        <div>
          <span class="stat-value">{host.stats.reviews}</span>
          <span class="stat-label">Reviews</span>
        </div>
        <div>
          <span class="stat-value">{host.stats.totalListings}</span>
          <span class="stat-label">Homes</span>
        </div>
      </div>
      <div class="hc-tip">
        <span class="hc-tip-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.1h6c0-.8.4-1.6 1-2.1A7 7 0 0 0 12 2Z" />
          </svg>
        </span>
        <p class="hc-tip-text">
          <strong>Quick tip:</strong> Message Peikar before you book — he usually replies within
          minutes and can help pick the right home for your group size.
        </p>
      </div>

      <a href="#stays" class="btn btn--white hero-card-cta">Browse the stays</a>
    </aside>
  </section>

  <!-- ============================ TRUST STRIP ============================ -->
  <section class="strip">
    <div class="container strip-inner">
      <div class="strip-item">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 1 3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5z"/></svg>
        <span>Identity verified · {host.verifiedSince}</span>
      </div>
      <div class="strip-item">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2l2.9 6.3 6.9.6-5.2 4.6 1.6 6.7L12 17.3 5.8 20.8l1.6-6.7L2.2 8.9l6.9-.6z"/></svg>
        <span>{host.stats.rating} average across {host.stats.reviews} reviews</span>
      </div>
      <div class="strip-item">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M4 4h16v4H4zm0 6h16v10H4z"/></svg>
        <span>Entire places · Groups up to 30 guests</span>
      </div>
      <div class="strip-item">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M3 11l19-9-9 19-2-8z"/></svg>
        <span>Speaks {host.languages}</span>
      </div>
    </div>
  </section>

  <!-- ============================ STAYS ============================ -->
  <section id="stays" class="section stays">
    <div class="container">
      <div class="stays-head">
        <span class="eyebrow">The collection</span>
        <h2 class="section-title">Vacation homes in &amp; around Kuantan</h2>
        <p class="stays-lede">
          From three-storey luxury houses to beachfront bungalows with private pools — pick the
          space that fits your group.
        </p>
      </div>
      <div class="stays-grid">
        {listings.map((listing) => <ListingCard listing={listing} />)}
      </div>
    </div>
  </section>

  <!-- ==================== FULL-SCREEN SHOWCASE (MekaVerse) ==================== -->
  <ShowcaseSection />

  <!-- ============================ ABOUT ============================ -->
  <section id="about" class="section about">
    <div class="container about-inner">
      <div class="about-photo">
        <img src={host.profilePhoto} alt="Peikar" width="360" height="360" />
        <span class="about-verified">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="#ff5a5f" d="M12 1 3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5z"/></svg>
          Verified since {host.verifiedSince}
        </span>
      </div>
      <div class="about-copy">
        <span class="eyebrow">About the host</span>
        <h2 class="section-title">Hosted with care by {host.name}</h2>
        <p class="about-text">
          Peikar is a verified Airbnb <strong>Superhost</strong> based in {host.location},
          welcoming travellers for {host.stats.yearsHosting} years. Guests consistently praise
          the spotless homes, quick replies and easy check-ins — earning a
          {' '}{host.stats.rating} rating across {host.stats.reviews} reviews.
        </p>
        <ul class="about-facts">
          {facts.map((f) => (
            <li>
              <span class="about-fact-label">{f.label}</span>
              <span class="about-fact-value">{f.value}</span>
            </li>
          ))}
        </ul>
        <a href={host.profileUrl} target="_blank" rel="noopener" class="btn btn--ghost">
          See the full profile on Airbnb
        </a>
      </div>
    </div>
  </section>

  <!-- ============================ REVIEWS ============================ -->
  <section id="reviews" class="section reviews">
    <div class="container">
      <div class="reviews-head">
        <span class="eyebrow">What guests say</span>
        <h2 class="section-title">{host.stats.reviews} reviews · {host.stats.rating} average</h2>
      </div>
      <div class="reviews-grid">
        {host.reviews.map((r) => (
          <figure class="review">
            <div class="review-stars">
              {Array.from({ length: r.rating }).map(() => (
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="#ff5a5f" d="M8 12.2 3.6 15l1.2-5-3.9-3.4 5.1-.4L8 1.5l2 4.7 5.1.4-3.9 3.4 1.2 5z"/></svg>
              ))}
            </div>
            <blockquote class="review-text">{r.text}</blockquote>
            <figcaption class="review-author">
              <img src={r.reviewerPhoto} alt={r.reviewer} width="44" height="44" loading="lazy" />
              <div>
                <span class="review-name">{r.reviewer}</span>
                <span class="review-meta">{r.reviewerLoc} · {r.date}</span>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================ TRAVEL ============================ -->
  <section id="travel" class="section travel">
    <div class="container">
      <div class="travel-head">
        <span class="eyebrow">Where Peikar has travelled</span>
        <h2 class="section-title">A host who loves to explore, too</h2>
      </div>
      <div class="travel-grid">
        {host.travels.map((t) => (
          <div class="travel-card">
            <span class="travel-loc">{t.location}</span>
            <span class="travel-date">{t.date}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================ CTA ============================ -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-card">
        <h2 class="cta-title">Planning a group getaway to Kuantan?</h2>
        <p class="cta-sub">
          Browse Peikar's {host.stats.totalListings} homes on Airbnb and book direct with a
          Superhost you can trust.
        </p>
        <a href={host.profileUrl} target="_blank" rel="noopener" class="btn btn--white cta-btn">
          View all stays on Airbnb
        </a>
      </div>
    </div>
  </section>

  <!-- ============================ FOOTER ============================ -->
  <footer class="footer">
    <div class="container footer-inner">
      <div>
        <p class="footer-brand">Peikar<span>·</span>stays</p>
        <p class="footer-note">Superhost · {host.location}</p>
      </div>
      <p class="footer-fine">
        Landing page compiled from Peikar's public Airbnb host profile. Not affiliated with
        Airbnb, Inc. · Ratings &amp; reviews as of August 2026.
      </p>
    </div>
  </footer>
</Base>

<script>
  // Pointer-parallax for the illustrated "Meet your host" card.
  const card = document.getElementById('hero-card');
  const bg = card?.querySelector<HTMLElement>('.hc-bg');
  const doodle = card?.querySelector<HTMLElement>('.hc-doodle');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (card && bg && !reduce && window.matchMedia('(hover: hover)').matches) {
    let raf = 0;
    let mx = 0;
    let my = 0;

    const apply = () => {
      // Blob layer drifts toward the cursor, doodles drift away → depth.
      bg.style.transform = `translate3d(${mx * 12}px, ${my * 12}px, 0)`;
      if (doodle) doodle.style.transform = `translate3d(${mx * -22}px, ${my * -22}px, 0)`;
      raf = 0;
    };

    const onMove = (e: PointerEvent) => {
      const r = card.getBoundingClientRect();
      mx = ((e.clientX - r.left) / r.width - 0.5) * 2;
      my = ((e.clientY - r.top) / r.height - 0.5) * 2;
      if (!raf) raf = window.requestAnimationFrame(apply);
    };

    const reset = () => {
      bg.style.transform = 'translate3d(0,0,0)';
      if (doodle) doodle.style.transform = 'translate3d(0,0,0)';
    };

    card.addEventListener('pointermove', onMove);
    card.addEventListener('pointerleave', reset);
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: 1.9fr 1fr;
    gap: var(--spacing-16);
    margin-top: var(--spacing-24);
  }
  .hero-photo {
    position: relative;
    border-radius: var(--radius-cards);
    min-height: 520px;
    background-size: cover;
    background-position: center;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }
  .hero-photo-overlay {
    width: 100%;
    padding: var(--spacing-40);
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.65));
    color: #fff;
  }
  .hero-badge { margin-bottom: var(--spacing-16); }
  .hero-title {
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0;
    max-width: 14ch;
  }
  .hero-sub { margin-top: var(--spacing-16); max-width: 46ch; font-size: var(--text-body); color: #f0f0ea; }

  .hero-card {
    position: relative;
    isolation: isolate;
    color: #2b2621;
    border-radius: var(--radius-cards);
    padding: var(--card-padding);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-24);
    overflow: hidden;
    /* Soft, gentle pastel wash */
    background: linear-gradient(155deg, #fff5ef 0%, #ffe9e0 45%, #eef4f7 100%);
    --mx: 0;
    --my: 0;
  }

  /* Illustrated background layer — parallaxes as a group */
  .hc-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    transition: transform 0.35s ease-out;
    will-change: transform;
  }

  .hc-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(34px);
    opacity: 0.6;
    will-change: transform;
  }
  .hc-blob--1 { width: 210px; height: 210px; top: -50px; left: -50px; background: #ffb9a6; animation: hc-float-a 11s ease-in-out infinite alternate; }
  .hc-blob--2 { width: 180px; height: 180px; top: -30px; right: -40px; background: #ffdcae; animation: hc-float-b 13s ease-in-out infinite alternate; }
  .hc-blob--3 { width: 200px; height: 200px; bottom: -50px; left: -30px; background: #b9e3d3; animation: hc-float-b 12s ease-in-out infinite alternate; }
  .hc-blob--4 { width: 240px; height: 240px; bottom: -70px; right: -60px; background: #c7d7f2; animation: hc-float-a 15s ease-in-out infinite alternate; }

  /* Doodles parallax in the opposite direction for depth */
  .hc-doodle {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.5;
    transition: transform 0.4s ease-out;
    will-change: transform;
  }
  .hc-d { transform-box: fill-box; transform-origin: center; }
  .hc-d--1 { animation: hc-spin 26s linear infinite; transform-origin: 330px 70px; }
  .hc-d--2 { animation: hc-bob 6s ease-in-out infinite; }
  .hc-d--3 { animation: hc-bob 7s ease-in-out infinite 0.5s; }
  .hc-d--4 { animation: hc-twinkle 3.5s ease-in-out infinite; }

  @keyframes hc-float-a {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(14px, -18px) scale(1.08); }
  }
  @keyframes hc-float-b {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(-16px, 14px) scale(1.06); }
  }
  @keyframes hc-spin { to { transform: rotate(360deg); } }
  @keyframes hc-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  @keyframes hc-twinkle {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  .hero-card .badge { align-self: flex-start; }
  .hero-card-host { display: flex; align-items: center; gap: var(--spacing-16); }
  .hero-card-host img {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-full);
    border: 3px solid #fff;
    object-fit: cover;
  }
  .hero-card-name { font-size: var(--text-heading); font-weight: 700; letter-spacing: 0; }
  .hero-card-role { font-size: var(--text-caption); color: #7a716a; }
  .hero-card-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-12);
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    padding-block: var(--spacing-20);
  }
  .hero-card-stats > div { display: flex; flex-direction: column; }
  .stat-value { font-size: var(--text-heading); font-weight: 700; letter-spacing: 0; }
  .stat-label { font-size: var(--text-caption); color: #7a716a; }
  .hc-tip {
    display: flex;
    gap: var(--spacing-12);
    align-items: flex-start;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius-cards);
    padding: 14px 16px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .hc-tip-icon {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: rgba(255, 90, 95, 0.12);
    color: var(--color-coral-pulse);
  }
  .hc-tip-text { font-size: var(--text-caption); line-height: 1.45; color: #5a5049; }
  .hc-tip-text strong { color: #2b2621; font-weight: 700; }

  .hero-card-cta { justify-content: center; margin-top: auto; }

  @media (prefers-reduced-motion: reduce) {
    .hc-blob, .hc-d { animation: none !important; }
    .hc-bg, .hc-doodle { transform: none !important; }
  }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; }
    .hero-photo { min-height: 420px; }
  }

  /* ---------- Trust strip ---------- */
  .strip { background: var(--color-sand-beige); margin-top: var(--spacing-24); }
  .strip-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-24) var(--spacing-40);
    justify-content: space-between;
    padding-block: var(--spacing-24);
  }
  .strip-item { display: flex; align-items: center; gap: var(--spacing-8); font-size: var(--text-caption); font-weight: 500; }
  .strip-item svg { color: var(--color-coral-pulse); flex-shrink: 0; }

  /* ---------- Stays ---------- */
  .stays-head { max-width: 640px; margin-bottom: var(--spacing-40); }
  .stays-head .eyebrow { display: block; margin-bottom: var(--spacing-12); }
  .stays-lede { margin-top: var(--spacing-16); font-size: var(--text-subheading); color: #4a4a44; }
  .stays-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-24);
  }
  @media (max-width: 900px) { .stays-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .stays-grid { grid-template-columns: 1fr; } }

  /* ---------- About ---------- */
  .about { background: var(--color-sand-beige); }
  .about-inner { display: grid; grid-template-columns: 360px 1fr; gap: var(--spacing-64); align-items: center; }
  .about-photo { position: relative; }
  .about-photo img { width: 100%; border-radius: var(--radius-cards); aspect-ratio: 1; object-fit: cover; }
  .about-verified {
    position: absolute;
    bottom: var(--spacing-16);
    left: var(--spacing-16);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--color-pristine-surface);
    padding: 8px 16px;
    border-radius: var(--radius-full);
    font-size: var(--text-caption);
    font-weight: 700;
  }
  .about-copy .eyebrow { display: block; margin-bottom: var(--spacing-12); }
  .about-text { margin-top: var(--spacing-16); font-size: var(--text-subheading); line-height: 1.6; max-width: 54ch; color: #2a2a26; }
  .about-facts {
    list-style: none;
    padding: 0;
    margin: var(--spacing-24) 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-12);
    max-width: 560px;
  }
  .about-facts li {
    background: var(--color-pristine-surface);
    border: var(--hairline);
    border-radius: var(--radius-cards);
    padding: var(--spacing-16);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .about-fact-label { font-size: var(--text-caption); color: var(--color-coral-pulse); font-weight: 700; }
  .about-fact-value { font-size: var(--text-body); font-weight: 500; }
  @media (max-width: 780px) {
    .about-inner { grid-template-columns: 1fr; gap: var(--spacing-32); }
    .about-photo img { max-width: 280px; }
  }

  /* ---------- Reviews ---------- */
  .reviews-head { margin-bottom: var(--spacing-40); }
  .reviews-head .eyebrow { display: block; margin-bottom: var(--spacing-12); }
  .reviews-grid { columns: 3; column-gap: var(--spacing-24); }
  @media (max-width: 900px) { .reviews-grid { columns: 2; } }
  @media (max-width: 560px) { .reviews-grid { columns: 1; } }
  .review {
    break-inside: avoid;
    background: var(--color-pristine-surface);
    border: var(--hairline);
    border-radius: var(--radius-cards);
    padding: var(--card-padding);
    margin-bottom: var(--spacing-24);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
  }
  .review-stars { display: flex; gap: 2px; }
  .review-text { font-size: var(--text-body); line-height: 1.55; color: #2a2a26; }
  .review-author { display: flex; align-items: center; gap: var(--spacing-12); margin-top: var(--spacing-4); }
  .review-author img { width: 44px; height: 44px; border-radius: var(--radius-full); object-fit: cover; }
  .review-name { display: block; font-weight: 700; font-size: var(--text-body); }
  .review-meta { display: block; font-size: var(--text-caption); color: #4a4a44; }

  /* ---------- Travel ---------- */
  .travel { background: var(--color-sand-beige); }
  .travel-head { margin-bottom: var(--spacing-40); }
