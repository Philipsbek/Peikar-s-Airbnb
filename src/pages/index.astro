---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import ListingCard from '../components/ListingCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ShowcaseSection from '../components/ShowcaseSection.astro';
import PhotoLightbox from '../components/PhotoLightbox.astro';
import host from '../data/host.json';

// De-duplicate listings that are the same property relisted (same short name).
const seen = new Set<string>();
const listings = host.listings.filter((l) => {
  if (seen.has(l.shortName + l.image)) return false;
  seen.add(l.shortName + l.image);
  return true;
});

const shortImage = host.listings[0].image;
const longImage = (host.listings[7] ?? host.listings[0]).image;

const waHref = `https://wa.me/${host.whatsapp.number}?text=${encodeURIComponent(host.whatsapp.message)}`;
const waLongMessage = `Hi Eztidor Solution! I'm interested in a long-term (monthly) homestay in Kuantan. Could you share monthly rates and availability?`;
const waLongHref = `https://wa.me/${host.whatsapp.number}?text=${encodeURIComponent(waLongMessage)}`;

const facts = [
  { label: 'Based in', value: host.location },
  { label: 'Homes', value: `${host.stats.totalListings} stays` },
  { label: 'Languages', value: host.languages },
];
---

<Base title="Eztidor Solution · Vacation homes in Kuantan, Malaysia">
  <span id="top"></span>
  <Nav />
  <WhatsAppButton />
  <PhotoLightbox />

  <!-- ============================ HERO ============================ -->
  <section class="hero container">
    <div class="hero-head">
      <span class="hero-eyebrow">Homestays in Kuantan, Malaysia</span>
      <h1 class="hero-title">Short stay or long stay — we have the home for it.</h1>
      <p class="hero-sub">
        Eztidor Solution runs spacious, spotless, fully-furnished homes across Kuantan. Whether
        you need a place for the weekend or for the season, choose the way you'd like to stay.
      </p>
    </div>

    <div class="hero-options">
      <article class="opt">
        <div class="opt-media">
          <img src={shortImage} alt="Short-term homestay in Kuantan" width="720" height="480" />
          <span class="opt-tag">Nightly</span>
        </div>
        <div class="opt-body">
          <span class="opt-kicker">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/></svg>
            Short-term homestay
          </span>
          <h2 class="opt-title">Weekends &amp; holidays, by the night</h2>
          <p class="opt-desc">
            Perfect for family getaways, group trips and quick escapes. Move-in-ready homes
            with everything set up, so you can arrive and relax.
          </p>
          <ul class="opt-points">
            <li>Weekend, holiday &amp; short-notice bookings</li>
            <li>Groups of up to 30 guests</li>
            <li>Fully furnished — kitchen, WiFi &amp; air-con</li>
            <li>Fast, friendly WhatsApp booking</li>
          </ul>
          <a href="#stays" class="btn btn--coral opt-cta">Browse short-term stays</a>
        </div>
      </article>

      <article class="opt">
        <div class="opt-media">
          <img src={longImage} alt="Long-term homestay in Kuantan" width="720" height="480" />
          <span class="opt-tag">Monthly</span>
        </div>
        <div class="opt-body">
          <span class="opt-kicker">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1z"/></svg>
            Long-term homestay
          </span>
          <h2 class="opt-title">Relocation &amp; extended stays, by the month</h2>
          <p class="opt-desc">
            A comfortable home base for work postings, relocation or a longer visit — set up
            for easy daily living, with flexible monthly terms.
          </p>
          <ul class="opt-points">
            <li>Discounted monthly rates</li>
            <li>Ideal for relocation &amp; remote work</li>
            <li>Furnished &amp; equipped for daily living</li>
            <li>Flexible durations — ask for a quote</li>
          </ul>
          <a href={waLongHref} target="_blank" rel="noopener" class="btn btn--ghost opt-cta">Enquire about long-term</a>
        </div>
      </article>
    </div>
  </section>

  <!-- ============================ TRUST STRIP ============================ -->
  <section class="strip">
    <div class="container strip-inner">
      <div class="strip-item">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 1 3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5z"/></svg>
        <span>Identity verified · {host.verifiedSince}</span>
      </div>
      <div class="strip-item">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2l2.9 6.3 6.9.6-5.2 4.6 1.6 6.7L12 17.3 5.8 20.8l1.6-6.7L2.2 8.9l6.9-.6z"/></svg>
        <span>{host.stats.rating} average across {host.stats.reviews} reviews</span>
      </div>
      <div class="strip-item">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M4 4h16v4H4zm0 6h16v10H4z"/></svg>
        <span>Entire places · Groups up to 30 guests</span>
      </div>
      <div class="strip-item">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M3 11l19-9-9 19-2-8z"/></svg>
        <span>Speaks {host.languages}</span>
      </div>
    </div>
  </section>

  <!-- ============================ STAYS ============================ -->
  <section id="stays" class="section stays">
    <div class="container">
      <div class="stays-head">
        <span class="eyebrow">The collection</span>
        <h2 class="section-title">Vacation homes in &amp; around Kuantan</h2>
        <p class="stays-lede">
          From three-storey luxury houses to beachfront bungalows with private pools — pick the
          space that fits your group.
        </p>
      </div>
      <div class="stays-grid">
        {listings.map((listing) => <ListingCard listing={listing} />)}
      </div>
    </div>
  </section>

  <!-- ==================== FULL-SCREEN SHOWCASE (MekaVerse) ==================== -->
  <ShowcaseSection />

  <!-- ============================ ABOUT ============================ -->
  <section id="about" class="section about">
    <div class="container about-inner">
      <div class="about-copy">
        <span class="eyebrow">About Eztidor Solution</span>
        <h2 class="section-title">Comfortable homestays, run with care</h2>
        <p class="about-text">
          Eztidor Solution manages spacious, spotless homestays across {host.location} — for
          short weekend getaways and long-term stays alike. Every home is fully furnished,
          guest-ready and backed by responsive local support, earning a
          {' '}{host.stats.rating} rating across {host.stats.reviews} reviews.
        </p>
        <div class="about-badges">
          <span class="about-badge about-badge--coral">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 1.5l2 4.7 5.1.4-3.9 3.4 1.2 5L8 12.2 3.6 15l1.2-5L.9 6.6l5.1-.4z"/></svg>
            Superhost
          </span>
          <span class="about-badge">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="var(--color-coral-pulse)" d="M12 1 3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5z"/></svg>
            Verified since {host.verifiedSince}
          </span>
        </div>
      </div>

      <aside class="about-card">
        <div class="about-stats">
          <div>
            <span class="as-value">{host.stats.rating}</span>
            <span class="as-label">Rating</span>
          </div>
          <div>
            <span class="as-value">{host.stats.reviews}</span>
            <span class="as-label">Reviews</span>
          </div>
          <div>
            <span class="as-value">{host.stats.yearsHosting}</span>
            <span class="as-label">Years hosting</span>
          </div>
        </div>
        <ul class="about-facts">
          {facts.map((f) => (
            <li>
              <span class="af-label">{f.label}</span>
              <span class="af-value">{f.value}</span>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <!-- ============================ REVIEWS ============================ -->
  <section id="reviews" class="section reviews">
    <div class="container">
      <div class="reviews-head">
        <span class="eyebrow">What guests say</span>
        <h2 class="section-title">{host.stats.reviews} reviews · {host.stats.rating} average</h2>
      </div>
      <div class="reviews-grid">
        {host.reviews.map((r) => (
          <figure class="review">
            <div class="review-stars">
              {Array.from({ length: r.rating }).map(() => (
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="#6f9350" d="M8 12.2 3.6 15l1.2-5-3.9-3.4 5.1-.4L8 1.5l2 4.7 5.1.4-3.9 3.4 1.2 5z"/></svg>
              ))}
            </div>
            <blockquote class="review-text">{r.text}</blockquote>
            <figcaption class="review-author">
              <img src={r.reviewerPhoto} alt={r.reviewer} width="44" height="44" loading="lazy" />
              <div>
                <span class="review-name">{r.reviewer}</span>
                <span class="review-meta">{r.reviewerLoc} · {r.date}</span>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================ CTA ============================ -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-card">
        <h2 class="cta-title">Planning a group getaway to Kuantan?</h2>
        <p class="cta-sub">
          Browse our {host.stats.totalListings} homes and message Eztidor Solution directly to
          book with a Superhost you can trust.
        </p>
        <a href={waHref} target="_blank" rel="noopener" class="btn btn--white cta-btn">
          Message us to book
        </a>
      </div>
    </div>
  </section>

  <!-- ============================ FOOTER ============================ -->
  <footer class="footer">
    <div class="container footer-inner">
      <div>
        <p class="footer-brand">Eztidor<span>·</span>Solution</p>
        <p class="footer-note">Superhost · {host.location}</p>
      </div>
      <p class="footer-fine">
        Eztidor Solution — homestays in Kuantan, Pahang. · Ratings &amp; reviews as of
        August 2026.
      </p>
    </div>
  </footer>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { margin-top: var(--spacing-40); }
  .hero-head { max-width: 720px; margin: 0 auto var(--spacing-40); text-align: center; }
  .hero-eyebrow { display: block; font-size: var(--text-caption); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-coral-pulse); }
  .hero-title { margin-top: var(--spacing-16); font-size: clamp(34px, 4.6vw, 56px); font-weight: 600; line-height: 1.08; color: var(--color-ink-black); }
  .hero-sub { margin-top: var(--spacing-16); font-size: var(--text-subheading); line-height: 1.55; color: #4a4a44; }

  .hero-options { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-24); align-items: stretch; }
  .opt {
    display: flex;
    flex-direction: column;
    background: var(--color-pristine-surface);
    border: var(--hairline);
    border-radius: var(--radius-cards);
    overflow: hidden;
    transition: transform 0.2s ease;
  }
  .opt:hover { transform: translateY(-4px); }
  .opt-media { position: relative; height: 260px; flex: 0 0 260px; overflow: hidden; }
  .opt-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .opt-tag {
    position: absolute; top: 14px; right: 14px;
    padding: 6px 14px; border-radius: var(--radius-full);
    background: var(--color-coral-pulse); color: #fff;
    font-size: var(--text-caption); font-weight: 700;
  }
  .opt-body { display: flex; flex-direction: column; flex: 1; padding: var(--spacing-32); }
  .opt-kicker { display: inline-flex; align-items: center; gap: 8px; font-size: var(--text-caption); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-coral-pulse); }
  .opt-title { margin-top: var(--spacing-12); font-size: var(--text-heading); font-weight: 600; line-height: 1.15; }
  .opt-desc { margin-top: var(--spacing-12); font-size: var(--text-body); line-height: 1.55; color: #4a4a44; }
  .opt-points { list-style: none; padding: 0; margin: var(--spacing-20) 0; display: grid; gap: var(--spacing-8); }
  .opt-points li { position: relative; padding-left: 26px; font-size: var(--text-caption); color: #2a2a26; }
  .opt-points li::before {
    content: '✓'; position: absolute; left: 0; top: -1px;
    width: 18px; height: 18px; border-radius: var(--radius-full);
    background: rgba(111, 147, 80, 0.16); color: var(--color-coral-pulse);
    font-size: 11px; font-weight: 700; display: grid; place-items: center;
  }
  .opt-cta { margin-top: auto; align-self: flex-start; }

  @media (max-width: 860px) {
    .hero-options { grid-template-columns: 1fr; gap: var(--spacing-24); }
    .opt-body { padding: var(--spacing-24); }
  }

  /* ---------- Trust strip ---------- */
  .strip { background: var(--color-sand-beige); margin-top: var(--spacing-24); }
  .strip-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-24) var(--spacing-40);
    justify-content: space-between;
    padding-block: var(--spacing-24);
  }
  .strip-item { display: flex; align-items: center; gap: var(--spacing-8); font-size: var(--text-caption); font-weight: 500; }
  .strip-item svg { color: var(--color-coral-pulse); flex-shrink: 0; }

  /* ---------- Stays ---------- */
  .stays-head { max-width: 640px; margin-bottom: var(--spacing-40); }
  .stays-head .eyebrow { display: block; margin-bottom: var(--spacing-12); }
  .stays-lede { margin-top: var(--spacing-16); font-size: var(--text-subheading); color: #4a4a44; }
  .stays-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-24);
  }
  @media (max-width: 900px) { .stays-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .stays-grid { grid-template-columns: 1fr; } }

  /* ---------- About ---------- */
  .about { background: var(--color-sand-beige); }
  .about-inner { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: var(--spacing-64); align-items: center; }
  .about-copy .eyebrow { display: block; margin-bottom: var(--spacing-12); }
  .about-text { margin-top: var(--spacing-16); font-size: var(--text-subheading); line-height: 1.6; max-width: 52ch; color: #2a2a26; }

  .about-badges { display: flex; flex-wrap: wrap; gap: var(--spacing-8); margin-top: var(--spacing-24); }
  .about-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    background: var(--color-pristine-surface);
    border: var(--hairline);
    font-size: var(--text-caption);
    font-weight: 700;
  }
  .about-badge--coral { background: var(--color-coral-pulse); border-color: var(--color-coral-pulse); color: #fff; }
  .about-cta { margin-top: var(--spacing-24); }

  /* Host credentials card (replaces the old photo) */
  .about-card { background: var(--color-pristine-surface); border: var(--hairline); border-radius: var(--radius-cards); padding: var(--spacing-32); }
  .about-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-12); padding-bottom: var(--spacing-24); border-bottom: var(--hairline); }
  .about-stats > div { display: flex; flex-direction: column; gap: 2px; }
  .as-value { font-size: var(--text-heading); font-weight: 700; }
  .as-label { font-size: var(--text-caption); color: #7a716a; }
  .about-facts { list-style: none; padding: 0; margin: 0; }
  .about-facts li { display: flex; align-items: baseline; justify-content: space-between; gap: var(--spacing-16); padding: var(--spacing-16) 0; border-bottom: var(--hairline); }
  .about-facts li:last-child { border-bottom: 0; padding-bottom: 0; }
  .af-label { font-size: var(--text-caption); color: #7a716a; flex: 0 0 auto; }
  .af-value { font-size: var(--text-body); font-weight: 700; text-align: right; }

  @media (max-width: 860px) {
    .about-inner { grid-template-columns: 1fr; gap: var(--spacing-32); }
  }

  /* ---------- Reviews ---------- */
  .reviews-head { margin-bottom: var(--spacing-40); }
  .reviews-head .eyebrow { display: block; margin-bottom: var(--spacing-12); }
  .reviews-grid { columns: 3; column-gap: var(--spacing-24); }
  @media (max-width: 900px) { .reviews-grid { columns: 2; } }
  @media (max-width: 560px) { .reviews-grid { columns: 1; } }
  .review {
    break-inside: avoid;
    background: var(--color-pristine-surface);
    border: var(--hairline);
    border-radius: var(--radius-cards);
    padding: var(--card-padding);
    margin-bottom: var(--spacing-24);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
  }
  .review-stars { display: flex; gap: 2px; }
  .review-text { font-size: var(--text-body); line-height: 1.55; color: #2a2a26; }
  .review-author { display: flex; align-items: center; gap: var(--spacing-12); margin-top: var(--spacing-4); }
  .review-author img { width: 44px; height: 44px; border-radius: var(--radius-full); object-fit: cover; }
  .review-name { display: block; font-weight: 700; font-size: var(--text-body); }
  .review-meta { display: block; font-size: var(--text-caption); color: #4a4a44; }

  /* ---------- CTA ---------- */
  .cta-card {
    position: relative;
    isolation: isolate;
    color: #fff;
    border-radius: var(--radius-cards);
    padding: var(--spacing-96) var(--spacing-40);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-16);
    overflow: hidden;
    background-image: url('/images/cta-bg.jpg');
    background-size: cover;
    background-position: center;
  }
  /* Legibility overlay over the CTA photo */
  .cta-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.6) 100%);
  }
  .cta-title { font-size: var(--text-display); font-weight: 700; letter-spacing: 0; line-height: 1.1; max-width: 18ch; }
  .cta-sub { max-width: 46ch; font-size: var(--text-subheading); opacity: 0.95; }
  .cta-btn { margin-top: var(--spacing-8); }

  /* ---------- Footer ---------- */
  .footer { background: var(--color-ink-black); color: #fff; padding-block: var(--spacing-64); }
  .footer-inner { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--spacing-24); flex-wrap: wrap; }
  .footer-brand { font-family: var(--font-display); font-size: var(--text-heading); font-weight: 600; letter-spacing: 0; }
  .footer-brand span { color: var(--color-clay); margin-inline: 2px; }
  .footer-note { font-size: var(--text-caption); opacity: 0.7; margin-top: 4px; }
  .footer-fine { font-size: var(--text-caption); opacity: 0.55; max-width: 48ch; }
</style>
