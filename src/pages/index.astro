---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import ListingCard from '../components/ListingCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ShowcaseSection from '../components/ShowcaseSection.astro';
import PhotoLightbox from '../components/PhotoLightbox.astro';
import host from '../data/host.json';

// De-duplicate listings that are the same property relisted (same short name).
const seen = new Set<string>();
const listings = host.listings.filter((l) => {
  if (seen.has(l.shortName + l.image)) return false;
  seen.add(l.shortName + l.image);
  return true;
});

const shortImage = host.listings[0].image;
const longImage = (host.listings[7] ?? host.listings[0]).image;

const waHref = `https://wa.me/${host.whatsapp.number}?text=${encodeURIComponent(host.whatsapp.message)}`;
const waLongMessage = `Hi Eztidor Solution! I'm interested in a long-term (monthly) homestay in Kuantan. Could you share monthly rates and availability?`;
const waLongHref = `https://wa.me/${host.whatsapp.number}?text=${encodeURIComponent(waLongMessage)}`;

const facts = [
  { label: 'Based in', value: host.location },
  { label: 'Homes', value: `${host.stats.totalListings} stays` },
  { label: 'Languages', value: host.languages },
];

const site = Astro.site ?? new URL('https://eztidorsolution.com');
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  '@id': new URL('/', site).href + '#business',
  name: 'Eztidor Solution',
  description:
    'Spacious, spotless short-term and long-term homestays in Kuantan, Pahang, Malaysia — hosted by a verified Superhost.',
  url: new URL('/', site).href,
  logo: new URL('/images/logo.png', site).href,
  image: new URL('/images/logo.png', site).href,
  telephone: '+' + host.whatsapp.number,
  priceRange: '$$',
  currenciesAccepted: 'MYR',
  knowsLanguage: ['en', 'ms', 'zh'],
  areaServed: { '@type': 'City', name: 'Kuantan' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kuantan',
    addressRegion: 'Pahang',
    addressCountry: 'MY',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 3.8077, longitude: 103.326 },
  // NOTE: aggregateRating intentionally omitted. Google requires it to reflect
  // first-party reviews shown on this page — not ratings pulled from Airbnb.
  // Only add it back once you collect genuine reviews on your own site/Google.
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Free WiFi', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Air conditioning', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Kitchen', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Free parking', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Swimming pool', value: true },
  ],
};
---

<Base title="Eztidor Solution · Vacation homes in Kuantan, Malaysia">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(localBusinessSchema)} />
  <span id="top"></span>
  <Nav />
  <WhatsAppButton />
  <PhotoLightbox />

  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <div class="hero-head">
      <span class="hero-eyebrow">Homestays in Kuantan, Malaysia</span>
      <h1 class="hero-title">Short stay or long stay — we have the home for it.</h1>
      <p class="hero-sub">
        Eztidor Solution runs spacious, spotless, fully-furnished homes across Kuantan. Whether
        you need a place for the weekend or for the season, choose the way you'd like to stay.
      </p>
    </div>

    <div class="hero-options">
      <article class="opt" id="short-stay">
        <div class="opt-media">
          <img src={shortImage} alt="Short-term homestay in Kuantan" width="720" height="480" />
          <span class="opt-tag">Nightly</span>
        </div>
        <div class="opt-body">
          <span class="opt-kicker">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/></svg>
            Short-term homestay
          </span>
          <h2 class="opt-title">Weekends &amp; holidays, by the night</h2>
          <p class="opt-desc">
            Perfect for family getaways, group trips and quick escapes. Move-in-ready homes
            with everything set up, so you can arrive and relax.
          </p>
          <ul class="opt-points">
            <li>Weekend, holiday &amp; short-notice bookings</li>
            <li>Groups of up to 30 guests</li>
            <li>Fully furnished — kitchen, WiFi &amp; air-con</li>
            <li>Fast, friendly WhatsApp booking</li>
          </ul>
          <a href="#stays" class="btn btn--coral opt-cta">Browse short-term stays</a>
          <a href="#long-stay" class="opt-next" aria-label="Continue to long-term stays">
            <span>Explore long-term stays</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </a>
        </div>
        <p class="opt-rent-label" aria-hidden="true"><span>Short Term</span><br /><span>Rent</span></p>
      </article>

      <article class="opt" id="long-stay">
        <div class="opt-media">
          <img src={longImage} alt="Long-term homestay in Kuantan" width="720" height="480" />
          <span class="opt-tag">Monthly</span>
        </div>
        <div class="opt-body">
          <span class="opt-kicker">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1z"/></svg>
            Long-term homestay
          </span>
          <h2 class="opt-title">Relocation &amp; extended stays, by the month</h2>
          <p class="opt-desc">
            A comfortable home base for work postings, relocation or a longer visit — set up
            for easy daily living, with flexible monthly terms.
          </p>
          <ul class="opt-points">
            <li>Discounted monthly rates</li>
            <li>Ideal for relocation &amp; remote work</li>
            <li>Furnished &amp; equipped for daily living</li>
            <li>Flexible durations — ask for a quote</li>
          </ul>
          <a href={waLongHref} target="_blank" rel="noopener noreferrer" class="btn btn--ghost opt-cta">Enquire about long-term</a>
          <a href="#stays" class="opt-next" aria-label="Continue to the property collection">
            <span>View all properties</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </a>
        </div>
        <p class="opt-rent-label" aria-hidden="true"><span>Long Term</span><br /><span>Rent</span></p>
      </article>
    </div>
  </section>

  <!-- ============================ TRUST STRIP ============================ -->
  <section class="strip">
    <div class="container strip-inner">
      <div class="strip-item">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 1 3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5z"/></svg>
        <span>Identity verified · {host.verifiedSince}</span>
      </div>
      <div class="strip-item">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2l2.9 6.3 6.9.6-5.2 4.6 1.6 6.7L12 17.3 5.8 20.8l1.6-6.7L2.2 8.9l6.9-.6z"/></svg>
        <span>{host.stats.rating} average across {host.stats.reviews} reviews</span>
      </div>
      <div class="strip-item">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M4 4h16v4H4zm0 6h16v10H4z"/></svg>
        <span>Entire places · Groups up to 30 guests</span>
      </div>
      <div class="strip-item">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M3 11l19-9-9 19-2-8z"/></svg>
        <span>Speaks {host.languages}</span>
      </div>
    </div>
  </section>

  <!-- ============================ STAYS ============================ -->
  <section id="stays" class="section stays">
    <div class="container">
      <div class="stays-head">
        <span class="eyebrow">The collection</span>
        <h2 class="section-title">Vacation homes in &amp; around Kuantan</h2>
        <p class="stays-lede">
          From three-storey luxury houses to beachfront bungalows with private pools — pick the
          space that fits your group.
        </p>
      </div>
      <div class="stays-toolbar">
        <div class="guest-filters" role="group" aria-label="Filter properties by guest capacity">
          <button class="guest-filter is-active" type="button" data-min="0" data-max="99" aria-pressed="true">All homes</button>
          <button class="guest-filter" type="button" data-min="0" data-max="15" aria-pressed="false">Up to 15 guests</button>
          <button class="guest-filter" type="button" data-min="16" data-max="20" aria-pressed="false">16–20 guests</button>
          <button class="guest-filter" type="button" data-min="21" data-max="30" aria-pressed="false">21–30 guests</button>
        </div>
        <p class="stays-count" aria-live="polite"><span>{listings.length}</span> homes</p>
      </div>
      <div class="stays-grid">
        {listings.map((listing) => (
          <div class="stay-item" data-guests={listing.guests}>
            <ListingCard listing={listing} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== FULL-SCREEN SHOWCASE (MekaVerse) ==================== -->
  <ShowcaseSection />

  <!-- ============================ ABOUT ============================ -->
  <section id="about" class="section about">
    <div class="container about-inner">
      <div class="about-copy">
        <span class="eyebrow">About Eztidor Solution</span>
        <h2 class="section-title">Comfortable homestays, run with care</h2>
        <p class="about-text">
          Eztidor Solution manages spacious, spotless homestays across {host.location} — for
          short weekend getaways and long-term stays alike. Every home is fully furnished,
          guest-ready and backed by responsive local support, earning a
          {' '}{host.stats.rating} rating across {host.stats.reviews} reviews.
        </p>
        <div class="about-badges">
          <span class="about-badge about-badge--coral">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 1.5l2 4.7 5.1.4-3.9 3.4 1.2 5L8 12.2 3.6 15l1.2-5L.9 6.6l5.1-.4z"/></svg>
            Superhost
          </span>
          <span class="about-badge">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="var(--color-coral-pulse)" d="M12 1 3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5z"/></svg>
            Verified since {host.verifiedSince}
          </span>
        </div>
      </div>

      <aside class="about-card">
        <div class="about-stats">
          <div>
            <span class="as-value">{host.stats.rating}</span>
            <span class="as-label">Rating</span>
          </div>
          <div>
            <span class="as-value">{host.stats.reviews}</span>
            <span class="as-label">Reviews</span>
          </div>
          <div>
            <span class="as-value">{host.stats.yearsHosting}</span>
            <span class="as-label">Years hosting</span>
          </div>
        </div>
        <ul class="about-facts">
          {facts.map((f) => (
            <li>
              <span class="af-label">{f.label}</span>
              <span class="af-value">{f.value}</span>
            </li>
          ))}
        </ul>
        <p class="about-note">Rating and reviews from Airbnb.</p>
      </aside>
    </div>
  </section>

  <!-- ============================ REVIEWS ============================ -->
  <section id="reviews" class="section reviews">
    <div class="container">
      <div class="reviews-head">
        <span class="eyebrow">What guests say</span>
        <h2 class="section-title">{host.stats.reviews} reviews · {host.stats.rating} average</h2>
        <p class="reviews-note">Verified guest ratings and reviews from our Airbnb listings.</p>
      </div>
      <div class="reviews-grid">
        {host.reviews.map((r) => (
          <figure class="review">
            <div class="review-stars">
              {Array.from({ length: r.rating }).map(() => (
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="var(--color-coral-pulse)" d="M8 12.2 3.6 15l1.2-5-3.9-3.4 5.1-.4L8 1.5l2 4.7 5.1.4-3.9 3.4 1.2 5z"/></svg>
              ))}
            </div>
            <blockquote class="review-text">{r.text}</blockquote>
            <figcaption class="review-author">
              <img src={r.reviewerPhoto} alt={r.reviewer} width="44" height="44" loading="lazy" />
              <div>
                <span class="review-name">{r.reviewer}</span>
                <span class="review-meta">{r.reviewerLoc} · {r.date}</span>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================ CTA ============================ -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-card">
        <h2 class="cta-title">Planning a group getaway to Kuantan?</h2>
        <p class="cta-sub">
          Browse our {host.stats.totalListings} homes and message Eztidor Solution directly to
          book with a Superhost you can trust.
        </p>
        <a href={waHref} target="_blank" rel="noopener noreferrer" class="btn btn--white cta-btn">
          Message us to book
        </a>
      </div>
    </div>
  </section>

  <!-- ============================ FOOTER ============================ -->
  <footer class="footer">
    <div class="container footer-inner">
      <div>
        <p class="footer-brand">Eztidor<span>·</span>Solution</p>
        <p class="footer-note">Superhost · {host.location}</p>
      </div>
      <p class="footer-fine">
        Eztidor Solution — homestays in Kuantan, Pahang. · Ratings &amp; reviews as of
        August 2026.
      </p>
    </div>
  </footer>
</Base>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reducedMotion) {
    document.documentElement.classList.add('motion-ready');

    const revealItems = document.querySelectorAll<HTMLElement>(
      '.hero-head, .strip-inner, .stays-head, .stays-grid > *, .about-inner, .reviews-head, .reviews-grid > *, .cta-card'
    );

    revealItems.forEach((item) => item.classList.add('is-reveal'));

    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );

    revealItems.forEach((item) => revealObserver.observe(item));

  }

  const guestFilters = Array.from(document.querySelectorAll<HTMLButtonElement>('.guest-filter'));
  const stayItems = Array.from(document.querySelectorAll<HTMLElement>('.stay-item'));
  const staysCount = document.querySelector<HTMLElement>('.stays-count span');

  guestFilters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const min = Number(filter.dataset.min ?? 0);
      const max = Number(filter.dataset.max ?? 99);
      let visible = 0;

      guestFilters.forEach((button) => {
        const active = button === filter;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      stayItems.forEach((item) => {
        const guests = Number(item.dataset.guests ?? 0);
        const matches = guests >= min && guests <= max;
        item.hidden = !matches;
        if (matches) visible += 1;
      });

      if (staysCount) staysCount.textContent = String(visible);
    });
  });
</script>

<style>
  /* ---------- Hero ---------- */
  .hero { margin-top: var(--spacing-40); }
  .hero-head { max-width: 760px; margin: 0 auto; padding: var(--spacing-40) 24px var(--spacing-64); text-align: center; }
  .hero-eyebrow { display: block; font-size: var(--text-caption); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-coral-pulse); }
  .hero-title { margin-top: var(--spacing-16); font-size: clamp(34px, 4.6vw, 56px); font-weight: 600; line-height: 1.08; color: var(--color-ink-black); }
  .hero-sub { margin-top: var(--spacing-16); font-size: var(--text-subheading); line-height: 1.55; color: #4a4a44; }

  .hero-options { display: grid; grid-template-columns: 1fr; }
  .opt {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }
  .opt-media { position: absolute; inset: 0; z-index: -2; overflow: hidden; clip-path: inset(0); }
  .opt-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(23, 15, 9, 0.82) 0%, rgba(23, 15, 9, 0.48) 50%, rgba(23, 15, 9, 0.12) 100%);
  }
  .opt:nth-child(even) .opt-media::after { background: linear-gradient(90deg, rgba(23, 15, 9, 0.82) 0%, rgba(23, 15, 9, 0.48) 50%, rgba(23, 15, 9, 0.12) 100%); }
  .opt-media img { position: fixed; inset: 0; width: 100vw; height: 100svh; object-fit: cover; display: block; }
  .opt-tag {
    position: absolute; top: clamp(24px, 4vw, 56px); right: clamp(24px, 5vw, 72px);
    padding: 8px 16px; border: 1px solid rgba(255, 255, 255, 0.7); border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.14); color: #fff; backdrop-filter: blur(12px);
    font-size: var(--text-caption); font-weight: 700;
  }
  .opt-body { width: min(680px, 100%); padding: clamp(48px, 8vw, 112px) clamp(24px, 7vw, 104px); color: #fff; }
  .opt-rent-label { position: absolute; right: clamp(28px, 7vw, 104px); top: 50%; z-index: 1; translate: 0 -50%; max-width: 7ch; color: rgba(255, 255, 255, 0.72); font-family: var(--font-display); font-size: clamp(64px, 7vw, 112px); font-weight: 600; line-height: 0.88; letter-spacing: -0.045em; text-align: right; text-wrap: balance; pointer-events: none; }
  .opt-kicker { display: inline-flex; align-items: center; gap: 8px; font-size: var(--text-caption); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: #f0cfaa; }
  .opt-title { margin-top: var(--spacing-16); font-size: clamp(38px, 5vw, 72px); font-weight: 600; line-height: 1.02; text-wrap: balance; }
  .opt-desc { margin-top: var(--spacing-20); max-width: 54ch; font-size: var(--text-subheading); line-height: 1.55; color: rgba(255, 255, 255, 0.86); }
  .opt-points { list-style: none; padding: 0; margin: var(--spacing-20) 0; display: grid; gap: var(--spacing-8); }
  .opt-points li { position: relative; padding-left: 26px; font-size: var(--text-caption); color: rgba(255, 255, 255, 0.9); }
  .opt-points li::before {
    content: '✓'; position: absolute; left: 0; top: -1px;
    width: 18px; height: 18px; border-radius: var(--radius-full);
    background: rgba(166, 111, 63, 0.16); color: var(--color-coral-pulse);
    font-size: 11px; font-weight: 700; display: grid; place-items: center;
  }
  .opt-cta { margin-top: var(--spacing-8); align-self: flex-start; border-color: #fff; }
  .opt .btn--ghost { color: #fff; }
  .opt .btn--ghost:hover { background: #fff; color: var(--color-ink-black); }
  .opt-next { display: flex; align-items: center; gap: 10px; width: max-content; margin-top: var(--spacing-24); color: rgba(255, 255, 255, 0.8); font-size: var(--text-caption); font-weight: 700; }
  .opt-next svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.2s ease; }
  .opt-next:hover { color: #fff; }
  .opt-next:hover svg { transform: translateY(4px); }

  :global(.motion-ready .is-reveal) { opacity: 0; transform: translateY(30px); transition: opacity 0.72s ease, transform 0.72s cubic-bezier(0.22, 0.7, 0.24, 1); }
  :global(.motion-ready .is-reveal.is-visible) { opacity: 1; transform: translateY(0); }
  :global(.motion-ready .stays-grid > .is-reveal:nth-child(2)) { transition-delay: 70ms; }
  :global(.motion-ready .stays-grid > .is-reveal:nth-child(3)) { transition-delay: 140ms; }

  @media (max-width: 860px) {
    .hero-head { padding-top: var(--spacing-24); }
    .opt { min-height: 100svh; }
    .opt-media::after,
    .opt:nth-child(even) .opt-media::after { background: linear-gradient(0deg, rgba(23, 15, 9, 0.9) 0%, rgba(23, 15, 9, 0.48) 62%, rgba(23, 15, 9, 0.08) 100%); }
    .opt-rent-label { display: none; }
    .opt-body { width: 100%; padding: 96px 24px 48px; }
    .opt-title { font-size: clamp(36px, 11vw, 54px); }
    .opt-desc { font-size: var(--text-body); }
  }
  @media (max-width: 420px) {
    .opt { min-height: 760px; }
    .opt-points { margin-block: var(--spacing-16); }
  }
  @media (prefers-reduced-motion: reduce) {
    .opt-media img, .opt-next svg, :global(.motion-ready .is-reveal) { transition: none; transform: none !important; }
    :global(.motion-ready .is-reveal) { opacity: 1; }
  }

  /* ---------- Trust strip ---------- */
  .strip { background: var(--color-sand-beige); margin-top: 0; }
  .strip-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-24) var(--spacing-40);
    justify-content: space-between;
    padding-block: var(--spacing-24);
  }
  .strip-item { display: flex; align-items: center; gap: var(--spacing-8); font-size: var(--text-caption); font-weight: 500; }
  .strip-item svg { color: var(--color-coral-pulse); flex-shrink: 0; }

  /* ---------- Stays ---------- */
  .stays-head { max-width: 640px; margin-bottom: var(--spacing-40); }
  .stays-head .eyebrow { display: block; margin-bottom: var(--spacing-12); }
  .stays-lede { margin-top: var(--spacing-16); font-size: var(--text-subheading); color: #4a4a44; }
  .stays-toolbar { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-16); margin-bottom: var(--spacing-24); }
  .guest-filters { display: flex; flex-wrap: wrap; gap: var(--spacing-8); }
  .guest-filter { min-height: 42px; padding: 9px 16px; border: var(--hairline); border-radius: var(--radius-full); background: var(--color-pristine-surface); color: var(--color-ink-black); font-size: var(--text-caption); font-weight: 700; transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease, transform 0.18s ease; }
  .guest-filter:hover { border-color: var(--color-coral-pulse); color: var(--color-coral-pulse); transform: translateY(-1px); }
  .guest-filter.is-active { background: var(--color-coral-pulse); border-color: var(--color-coral-pulse); color: #fff; }
  .stays-count { flex: 0 0 auto; font-size: var(--text-caption); font-weight: 700; color: #4a4a44; }
  .stays-grid {
    display: grid;
