---
// Shared single-image photo viewer. Include once per page; open it from anywhere
// with window.openPhotoLightbox(images, title, index).
---

<dialog id="photo-lightbox" class="plb" aria-label="Photo viewer">
  <div class="plb-shell">
    <header class="plb-bar">
      <p class="plb-title" data-plb-title></p>
      <span class="plb-count" data-plb-count aria-live="polite"></span>
      <button class="plb-close" type="button" data-plb-close aria-label="Close photo viewer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
    </header>
    <div class="plb-stage">
      <button class="plb-arrow plb-prev" type="button" data-plb-prev aria-label="Previous photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
      <img class="plb-img" data-plb-img alt="" />
      <button class="plb-arrow plb-next" type="button" data-plb-next aria-label="Next photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
    </div>
    <p class="plb-hint">Swipe or use arrow keys to browse</p>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('photo-lightbox') as HTMLDialogElement | null;
  if (dialog) {
    const image = dialog.querySelector<HTMLImageElement>('[data-plb-img]')!;
    const titleEl = dialog.querySelector<HTMLElement>('[data-plb-title]')!;
    const countEl = dialog.querySelector<HTMLElement>('[data-plb-count]')!;
    let items: string[] = [];
    let title = '';
    let index = 0;
    let pointerStart = 0;

    const render = () => {
      image.classList.remove('is-ready');
      image.src = items[index];
      image.alt = `${title} — photo ${index + 1} of ${items.length}`;
      titleEl.textContent = title;
      countEl.textContent = `${index + 1} / ${items.length}`;
      const multiple = items.length > 1;
      dialog.querySelectorAll<HTMLElement>('.plb-arrow').forEach((a) => (a.style.display = multiple ? '' : 'none'));
    };
    const move = (step: number) => {
      index = (index + step + items.length) % items.length;
      render();
    };

    image.addEventListener('load', () => image.classList.add('is-ready'));
    dialog.querySelector('[data-plb-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-plb-prev]')?.addEventListener('click', () => move(-1));
    dialog.querySelector('[data-plb-next]')?.addEventListener('click', () => move(1));
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); move(-1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); move(1); }
    });
    image.addEventListener('pointerdown', (event) => { pointerStart = event.clientX; });
    image.addEventListener('pointerup', (event) => {
      const distance = event.clientX - pointerStart;
      if (Math.abs(distance) > 50) move(distance > 0 ? -1 : 1);
    });
    dialog.addEventListener('close', () => { document.documentElement.style.overflow = ''; });

    (window as any).openPhotoLightbox = (images: string[], name: string, startIndex = 0) => {
      if (!images?.length) return;
      items = images;
      title = name || '';
      index = Math.max(0, Math.min(images.length - 1, startIndex));
      render();
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
    };
  }
</script>

<style is:global>
  .plb { width: 100vw; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; color: #fff; overflow: hidden; }
  .plb::backdrop { background: rgba(12, 11, 10, 0.94); backdrop-filter: blur(10px); }
  .plb-shell { position: relative; width: 100%; height: 100%; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; padding: 20px 24px 16px; background: rgba(12, 11, 10, 0.96); }
  .plb-bar { display: grid; grid-template-columns: minmax(0, 1fr) auto 44px; align-items: center; gap: 16px; min-height: 52px; }
  .plb-title { overflow: hidden; color: #fff; font-size: 16px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
  .plb-count { padding: 7px 12px; border: 1px solid rgba(255, 255, 255, 0.28); border-radius: 999px; color: #fff; font-size: 13px; font-weight: 700; }
  .plb-close, .plb-arrow { display: grid; place-items: center; border: 0; border-radius: 999px; background: #fff; color: #000; cursor: pointer; transition: background 0.18s ease, transform 0.18s ease; }
  .plb-close { width: 44px; height: 44px; }
  .plb-close:hover, .plb-arrow:hover { background: var(--color-coral-pulse); color: #fff; transform: scale(1.05); }
  .plb-close svg, .plb-arrow svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .plb-stage { position: relative; min-height: 0; display: grid; grid-template-columns: 52px minmax(0, 1fr) 52px; align-items: center; gap: 20px; }
  .plb-img { width: 100%; height: 100%; max-height: calc(100dvh - 132px); object-fit: contain; opacity: 0; user-select: none; touch-action: pan-y; transition: opacity 0.24s ease; }
  .plb-img.is-ready { opacity: 1; }
  .plb-arrow { width: 52px; height: 52px; }
  .plb-hint { margin: 8px 0 0; color: rgba(255, 255, 255, 0.62); font-size: 12px; text-align: center; }

  @media (max-width: 700px) {
    .plb-shell { padding: 12px 12px 10px; }
    .plb-bar { grid-template-columns: minmax(0, 1fr) auto 40px; gap: 8px; }
    .plb-title { font-size: 14px; }
    .plb-close { width: 40px; height: 40px; }
    .plb-stage { display: block; }
    .plb-img { height: 100%; max-height: calc(100dvh - 112px); }
    .plb-arrow { position: absolute; top: 50%; z-index: 2; width: 42px; height: 42px; translate: 0 -50%; }
    .plb-prev { left: 4px; }
    .plb-next { right: 4px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .plb-img, .plb-close, .plb-arrow { transition: none; }
    .plb-close:hover, .plb-arrow:hover { transform: none; }
  }
</style>
