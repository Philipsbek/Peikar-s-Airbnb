---
import host from '../data/host.json';

const number = host.whatsapp.number.replace(/[^0-9]/g, '');
const href = `https://wa.me/${number}?text=${encodeURIComponent(host.whatsapp.message)}`;
---

<a
  class="wa-fab"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="Chat with Eztidor Solution on WhatsApp"
>
  <span class="wa-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="26" height="26">
      <path
        fill="currentColor"
        d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.515 5.26l-.999 3.648 3.973-1.207zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.099-.198.05-.372-.025-.521-.074-.148-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
      />
    </svg>
  </span>
  <span class="wa-label">Chat with us</span>
</a>

<style>
  /* Official WhatsApp brand green */
  .wa-fab {
    --wa-green: #25d366;
    position: fixed;
    right: var(--spacing-24);
    bottom: var(--spacing-24);
    z-index: 100;
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-8);
    padding: 12px 22px 12px 14px;
    background: var(--wa-green);
    color: #fff;
    border-radius: var(--radius-full);
    font-size: var(--text-body);
    font-weight: 700;
    letter-spacing: 0;
    box-shadow:
      0 10px 24px rgba(37, 211, 102, 0.4),
      0 4px 10px rgba(0, 0, 0, 0.12);
    transition:
      transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.24s ease,
      background 0.18s ease;
  }

  /* Gently pulsing attention ring behind the button */
  .wa-fab::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.55);
    animation: wa-pulse 2.4s ease-out infinite;
    pointer-events: none;
  }
  @keyframes wa-pulse {
    0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5); }
    70% { box-shadow: 0 0 0 18px rgba(37, 211, 102, 0); }
    100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
  }

  .wa-fab:hover {
    transform: translateY(-4px) scale(1.04);
    background: #1ebe5a;
    box-shadow:
      0 20px 42px rgba(37, 211, 102, 0.52),
      0 8px 18px rgba(0, 0, 0, 0.18);
  }
  .wa-fab:hover::before { animation-play-state: paused; }
  .wa-fab:active { transform: translateY(-1px) scale(0.99); }

  /* White official glyph directly on the green pill */
  .wa-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: #fff;
    flex-shrink: 0;
    transition: transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .wa-fab:hover .wa-icon { transform: scale(1.08); }
  .wa-label { padding-right: 4px; }

  /* Collapse to a round icon-only button on small screens */
  @media (max-width: 560px) {
    .wa-fab {
      padding: 14px;
      right: var(--spacing-16);
      bottom: var(--spacing-16);
    }
    .wa-label { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-fab { transition: box-shadow 0.24s ease, background 0.18s ease; }
    .wa-fab::before { animation: none; }
    .wa-fab:hover { transform: none; }
    .wa-fab:hover .wa-icon { transform: none; }
  }
</style>
