---
import host from '../data/host.json';

const number = host.whatsapp.number.replace(/[^0-9]/g, '');
const href = `https://wa.me/${number}?text=${encodeURIComponent(host.whatsapp.message)}`;
---

<a
  class="wa-fab"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="Chat with Eztidor Solution on WhatsApp"
>
  <span class="wa-icon" aria-hidden="true">
    <svg viewBox="0 0 32 32" width="26" height="26">
      <path
        fill="currentColor"
        d="M16.003 3C9.38 3 3.998 8.38 3.998 15c0 2.096.55 4.142 1.594 5.945L3 29l8.28-2.54A12.9 12.9 0 0 0 16 27c6.623 0 12.005-5.38 12.005-12S22.626 3 16.003 3zm0 21.8c-1.86 0-3.68-.5-5.27-1.44l-.38-.22-4.9 1.5 1.5-4.78-.25-.4A9.78 9.78 0 0 1 6.2 15c0-5.4 4.4-9.8 9.8-9.8 5.4 0 9.8 4.4 9.8 9.8 0 5.4-4.4 9.8-9.8 9.8zm5.37-7.34c-.29-.15-1.72-.85-1.98-.95-.27-.1-.46-.15-.66.15-.2.29-.76.95-.93 1.14-.17.2-.34.22-.63.07-.29-.15-1.23-.45-2.34-1.44-.86-.77-1.44-1.72-1.61-2-.17-.29-.02-.44.13-.59.13-.13.29-.34.44-.5.15-.17.2-.29.29-.48.1-.2.05-.36-.02-.5-.07-.15-.66-1.6-.9-2.19-.24-.57-.48-.5-.66-.5-.17 0-.36-.02-.56-.02s-.5.07-.77.36c-.27.29-1.02 1-1.02 2.44 0 1.44 1.05 2.83 1.19 3.03.15.2 2.05 3.14 4.97 4.4.69.3 1.24.48 1.66.61.7.22 1.33.19 1.83.12.56-.08 1.72-.7 1.96-1.38.24-.68.24-1.26.17-1.38-.07-.12-.27-.2-.56-.34z"
      />
    </svg>
  </span>
  <span class="wa-label">Chat with us</span>
</a>

<style>
  .wa-fab {
    position: fixed;
    right: var(--spacing-24);
    bottom: var(--spacing-24);
    z-index: 100;
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-8);
    padding: 12px 20px 12px 12px;
    background: var(--color-coral-pulse);
    color: #fff;
    border-radius: var(--radius-full);
    font-size: var(--text-body);
    font-weight: 700;
    letter-spacing: 0;
    /* Attractive layered glow — a red halo over a soft ambient shadow */
    box-shadow:
      0 10px 24px rgba(166, 111, 63, 0.38),
      0 4px 10px rgba(0, 0, 0, 0.12);
    transition:
      transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.24s ease;
  }

  /* Gently pulsing attention ring behind the button */
  .wa-fab::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    box-shadow: 0 0 0 0 rgba(166, 111, 63, 0.55);
    animation: wa-pulse 2.4s ease-out infinite;
    pointer-events: none;
  }
  @keyframes wa-pulse {
    0% { box-shadow: 0 0 0 0 rgba(166, 111, 63, 0.5); }
    70% { box-shadow: 0 0 0 18px rgba(166, 111, 63, 0); }
    100% { box-shadow: 0 0 0 0 rgba(166, 111, 63, 0); }
  }

  .wa-fab:hover {
    transform: translateY(-4px) scale(1.04);
    box-shadow:
      0 20px 42px rgba(166, 111, 63, 0.52),
      0 8px 18px rgba(0, 0, 0, 0.18);
  }
  .wa-fab:hover::before { animation-play-state: paused; }
  .wa-fab:active { transform: translateY(-1px) scale(0.99); }

  .wa-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: #fff;
    color: var(--color-coral-pulse);
    flex-shrink: 0;
    transition: transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .wa-fab:hover .wa-icon { transform: rotate(-8deg) scale(1.1); }
  .wa-label { padding-right: 4px; }

  /* Collapse to a round icon-only button on small screens */
  @media (max-width: 560px) {
    .wa-fab {
      padding: 8px;
      right: var(--spacing-16);
      bottom: var(--spacing-16);
    }
    .wa-label { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-fab { transition: box-shadow 0.24s ease; }
    .wa-fab::before { animation: none; }
    .wa-fab:hover { transform: none; }
    .wa-fab:hover .wa-icon { transform: none; }
  }
</style>
