---
import host from '../data/host.json';
import LanguageSwitcher from './LanguageSwitcher.astro';

const links = [
  { href: '/#stays', label: 'Stays' },
  { href: '/blog', label: 'Blog' },
  { href: '/#reviews', label: 'Reviews' },
  { href: '/#about', label: 'About' },
];

const waHref = `https://wa.me/${host.whatsapp.number}?text=${encodeURIComponent(host.whatsapp.message)}`;
---

<header class="nav-wrap">
  <nav class="nav container">
    <a href="/" class="nav-brand"><img src="/images/logo.png" alt="Eztidor Solution — Homestay Services" /></a>

    <div class="nav-links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>

    <div class="nav-language"><LanguageSwitcher /></div>

    <a href={waHref} target="_blank" rel="noopener" class="btn btn--coral nav-cta">
      Book now
    </a>

    <button
      class="nav-burger"
      id="nav-burger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-mobile"
    >
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- Mobile dropdown -->
  <div class="nav-mobile container" id="nav-mobile" hidden>
    <div class="nav-mobile-panel">
      {links.map((l) => <a href={l.href} class="nav-mobile-link">{l.label}</a>)}
      <div class="nav-mobile-language">
        <span>Language</span>
        <LanguageSwitcher />
      </div>
      <a href={waHref} target="_blank" rel="noopener" class="btn btn--coral nav-mobile-cta">
        Book now
      </a>
    </div>
  </div>
</header>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: var(--spacing-16) 0 0;
    background: transparent;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-16);
    /* Frosted glass */
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.55);
    box-shadow: 0 6px 24px rgba(42, 35, 24, 0.06);
    border-radius: var(--radius-cards);
    height: 64px;
    padding-inline: var(--spacing-24);
    max-width: calc(var(--page-max-width) - 0px);
  }
  .nav-brand { display: inline-flex; align-items: center; }
  .nav-brand img { height: 42px; width: auto; display: block; }
  @media (max-width: 560px) { .nav-brand img { height: 36px; } }
  .nav-links {
    display: flex;
    gap: var(--spacing-24);
    font-size: var(--text-body);
    font-weight: 400;
  }
  .nav-links a { transition: color 0.15s ease; }
  .nav-links a:hover { color: var(--color-coral-pulse); }
  .nav-cta { padding: 10px 20px; font-size: var(--text-caption); }
  .nav-language { margin-left: auto; }

  /* Burger button — hidden on desktop */
  .nav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0 10px;
    background: transparent;
    border: var(--hairline);
    border-radius: var(--radius-full);
  }
  .nav-burger span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-ink-black);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .nav-burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .nav-burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile dropdown panel */
  .nav-mobile { margin-top: var(--spacing-8); }
  .nav-mobile[hidden] { display: none; }
  .nav-mobile-panel {
    background: var(--color-pristine-surface);
    border: var(--hairline);
    border-radius: var(--radius-cards);
    padding: var(--spacing-12);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }
  .nav-mobile-link {
    padding: var(--spacing-12) var(--spacing-16);
    border-radius: var(--radius-cards);
    font-size: var(--text-subheading);
    font-weight: 400;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .nav-mobile-link:hover { background: var(--color-sand-beige); color: var(--color-coral-pulse); }
  .nav-mobile-cta {
    margin-top: var(--spacing-8);
    justify-content: center;
    font-size: var(--text-body);
  }
  .nav-mobile-language { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-12); padding: var(--spacing-12) var(--spacing-16); border-top: var(--hairline); margin-top: var(--spacing-4); font-size: var(--text-caption); font-weight: 700; }

  @media (max-width: 860px) {
    .nav-links,
    .nav-cta,
    .nav-language { display: none; }
    .nav-burger { display: flex; }
  }

  /* Mobile: full-width header flush to the top, only a thin bottom hairline */
  @media (max-width: 560px) {
    .nav-wrap { padding-top: 0; }
    .nav {
      border: 0;
      border-bottom: var(--hairline);
      border-radius: 0;
    }
  }
  @media (min-width: 861px) {
    /* Never show the mobile panel on desktop, even if toggled then resized */
    .nav-mobile { display: none !important; }
  }
</style>

<script>
  const burger = document.getElementById('nav-burger');
  const menu = document.getElementById('nav-mobile');

  function setOpen(open: boolean) {
    if (!burger || !menu) return;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (open) menu.removeAttribute('hidden');
    else menu.setAttribute('hidden', '');
  }

  burger?.addEventListener('click', () => {
    setOpen(burger.getAttribute('aria-expanded') !== 'true');
  });

  // Close after tapping a link
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
