<style>
  .ambient-art { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; --ambient-x: 0px; --ambient-y: 0px; }
  .ambient-item { position: absolute; display: block; width: clamp(70px, 8vw, 126px); color: var(--color-coral-pulse); opacity: 0.13; translate: var(--ambient-x) var(--ambient-y); transition: translate 0.8s cubic-bezier(0.22, 0.7, 0.24, 1); }
  .ambient-item svg { width: 100%; height: auto; fill: none; stroke: currentColor; stroke-width: 1.45; stroke-linecap: round; stroke-linejoin: round; animation: ambient-float 8s ease-in-out infinite alternate; }
  .ambient-house { left: 4%; top: 12%; }
  .ambient-key { right: 5%; top: 18%; rotate: 12deg; }
  .ambient-palm { left: 8%; top: 54%; rotate: -8deg; }
  .ambient-pin { right: 8%; top: 48%; }
  .ambient-case { left: 35%; top: 78%; rotate: 6deg; }
  .ambient-sun { right: 30%; top: 7%; }
  .ambient-leaf { right: 3%; top: 78%; rotate: 15deg; }
  .ambient-cup { left: 44%; top: 35%; rotate: -5deg; }
  .ambient-key svg, .ambient-pin svg, .ambient-leaf svg { animation-delay: -2.4s; animation-duration: 10s; }
  .ambient-palm svg, .ambient-sun svg { animation-delay: -4.8s; animation-duration: 12s; }
  @keyframes ambient-float { from { transform: translate3d(0, -8px, 0) rotate(-1.5deg); } to { transform: translate3d(0, 12px, 0) rotate(2deg); } }
  @media (max-width: 720px) {
    .ambient-item { width: 72px; opacity: 0.1; }
    .ambient-cup, .ambient-case, .ambient-sun { display: none; }
    .ambient-house { left: -18px; top: 16%; }
    .ambient-key { right: -20px; top: 34%; }
    .ambient-palm { left: -14px; top: 62%; }
    .ambient-pin { right: -16px; top: 76%; }
    .ambient-leaf { right: 12%; top: 90%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ambient-item { translate: 0 0; transition: none; }
    .ambient-item svg { animation: none; }
  }
</style>

<script>
  const ambient = document.querySelector<HTMLElement>('.ambient-art');
  const reduceAmbientMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (ambient && !reduceAmbientMotion && window.matchMedia('(pointer: fine)').matches) {
    window.addEventListener('pointermove', (event) => {
      const x = (event.clientX / window.innerWidth - 0.5) * 10;
      const y = (event.clientY / window.innerHeight - 0.5) * 8;
      ambient.style.setProperty('--ambient-x', `${x}px`);
      ambient.style.setProperty('--ambient-y', `${y}px`);
    }, { passive: true });
  }
</script>
