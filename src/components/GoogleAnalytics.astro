---
// Google Analytics 4 (gtag.js). Loaded in production only so local dev and
// previews don't pollute analytics.
//
// CSP note: both scripts are EXTERNAL and allow-listed, so no 'unsafe-inline'
// is required:
//   - the gtag loader  -> script-src https://www.googletagmanager.com
//   - /ga.js (config)  -> script-src 'self' (served first-party from /public)
// See Base.astro CSP + public/_headers. Do NOT inline the config here — Astro
// renders <script> inside a {conditional} verbatim (unbundled), which would be
// an inline script the CSP blocks.
const GA_ID = 'G-1KPY258CJ4';
---

{
  import.meta.env.PROD && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
      <script is:inline src="/ga.js" />
    </>
  )
}
